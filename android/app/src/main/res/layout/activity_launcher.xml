<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/launcher_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/launcher_subtitle"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Game folder card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface_high"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_game_folder"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="/storage/emulated/0/FarCry"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_secondary"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChooseFolder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/choose_folder"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_verify"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Renderer + performance -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRenderer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface_high"
            app:layout_constraintTop_toBottomOf="@id/cardFolder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Графика &amp; Производительность"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/renderer"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_secondary"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleRenderer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAngle"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="ANGLE" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGles"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="GLES" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAuto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Авто" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fps_limit"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_secondary"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="60"
                    android:valueFrom="30"
                    android:valueTo="120"
                    android:stepSize="15" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 FPS (батарея)"
                        android:textSize="10sp"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="120 FPS (макс)"
                        android:textSize="10sp"
                        android:textColor="@color/on_surface_secondary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resolution_scale"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_secondary"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:stepSize="0.1" />

                <TextView
                    android:id="@+id/txtResValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% • Баланс качества и скорости"
                    android:textSize="10sp"
                    android:textColor="@color/accent2" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDynRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Динамическое разрешение (рекомендуется на слабых GPU)"
                    android:textSize="11sp"
                    android:checked="true"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Touch controls -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTouch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface_high"
            app:layout_constraintTop_toBottomOf="@id/cardRenderer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сенсорное управление"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTouch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_enable"
                    android:checked="true"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_sensitivity"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_secondary"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="1.0"
                    android:valueFrom="0.3"
                    android:valueTo="3.0"
                    android:stepSize="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_opacity"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_secondary" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="0.6"
                    android:valueFrom="0.2"
                    android:valueTo="1.0"
                    android:stepSize="0.1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditTouch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_edit_touch"
                    android:layout_marginTop="8dp"
                    app:icon="@android:drawable/ic_menu_edit"
                    style="@style/Widget.Material3.Button.TonalButton" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_mode_desc"
                    android:textSize="10sp"
                    android:textColor="@color/on_surface_secondary"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Optimization info -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOpt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/surface_high"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardTouch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/optimization_title"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:drawableStart="@android:drawable/ic_dialog_info"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/optimization_desc"
                    android:textSize="10sp"
                    android:textColor="@color/on_surface_secondary"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• ANGLE Vulkan вместо кривого GLES драйвера • ETC2/ASTC перепаковка • LTO + PGO • Потоковый LOD • 60-120 FPS лимит • Авто-детект Adreno/Mali/PowerVR"
                    android:textSize="10sp"
                    android:textColor="@color/on_surface"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Play button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="@string/btn_play"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardOpt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtAbout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:textSize="9sp"
            android:textColor="@color/on_surface_secondary"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnPlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NearChuckle Android WIP • github.com/Player124413/NearChuckle-android-wip-edition"
            android:textSize="8sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            app:layout_constraintTop_toBottomOf="@id/txtAbout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
